rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasStudentProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/Students/$(request.auth.uid));
    }

    function hasMentorProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/Mentors/$(request.auth.uid));
    }

    function hasSuperAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/SuperAdmins/$(request.auth.uid));
    }

    function isPortalUser() {
      return hasStudentProfile() || hasMentorProfile() || hasSuperAdminProfile();
    }

    function isSuperAdmin() {
      return hasSuperAdminProfile();
    }

    function courseEnrollmentId(studentId, courseId) {
      return studentId + "_" + courseId;
    }

    function enrollmentPath(studentId, courseId) {
      return /databases/$(database)/documents/Enrollments/$(courseEnrollmentId(studentId, courseId));
    }

    function isStudentEnrolledInCourse(studentId, courseId) {
      return signedIn()
        && exists(enrollmentPath(studentId, courseId))
        && get(enrollmentPath(studentId, courseId)).data.studentId == studentId
        && get(enrollmentPath(studentId, courseId)).data.courseId == courseId
        && get(enrollmentPath(studentId, courseId)).data.status == "active";
    }

    function isCurrentStudentEnrolledInCourse(courseId) {
      return isStudentEnrolledInCourse(request.auth.uid, courseId);
    }

    function isStudentEnrolledInGroup(studentId, courseId, groupId) {
      return isStudentEnrolledInCourse(studentId, courseId)
        && get(enrollmentPath(studentId, courseId)).data.groupId == groupId;
    }

    function isCurrentStudentEnrolledInGroup(courseId, groupId) {
      return isStudentEnrolledInGroup(request.auth.uid, courseId, groupId);
    }

    function groupPath(courseId, groupId) {
      return /databases/$(database)/documents/Courses/$(courseId)/Groups/$(groupId);
    }

    function isGroupMentor(courseId, groupId) {
      return signedIn()
        && exists(groupPath(courseId, groupId))
        && get(groupPath(courseId, groupId)).data.mentorId == request.auth.uid;
    }

    function isAttendanceReader() {
      return signedIn()
        && (
          resource.data.studentId == request.auth.uid
          || isGroupMentor(resource.data.courseId, resource.data.groupId)
        );
    }

    function isValidAttendanceWrite() {
      return request.resource.data.keys().hasOnly([
          "studentId",
          "courseId",
          "groupId",
          "lessonId",
          "attendedAt"
        ])
        && request.resource.data.studentId is string
        && request.resource.data.courseId is string
        && request.resource.data.groupId is string
        && request.resource.data.lessonId is string
        && request.resource.data.attendedAt is timestamp
        && isGroupMentor(
          request.resource.data.courseId,
          request.resource.data.groupId
        )
        && isStudentEnrolledInGroup(
          request.resource.data.studentId,
          request.resource.data.courseId,
          request.resource.data.groupId
        );
    }

    function isEnrollmentStatus(status) {
      return status in ["active", "paused", "completed", "cancelled"];
    }

    function hasValidOptionalEnrollmentFields() {
      return (
          !("groupId" in request.resource.data)
          || request.resource.data.groupId is string
        )
        && (
          !("mentorId" in request.resource.data)
          || request.resource.data.mentorId is string
        )
        && (
          !("price" in request.resource.data)
          || request.resource.data.price is number
        )
        && (
          !("completedAt" in request.resource.data)
          || request.resource.data.completedAt is timestamp
        )
        && (
          !("updatedAt" in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        );
    }

    function hasConsistentEnrollmentAssignment() {
      return (
          !("groupId" in request.resource.data)
          && !("mentorId" in request.resource.data)
        )
        || (
          request.resource.data.groupId is string
          && request.resource.data.groupId.size() > 0
          && request.resource.data.mentorId is string
          && request.resource.data.mentorId.size() > 0
          && exists(groupPath(
            request.resource.data.courseId,
            request.resource.data.groupId
          ))
          && get(groupPath(
            request.resource.data.courseId,
            request.resource.data.groupId
          )).data.mentorId == request.resource.data.mentorId
        );
    }

    function isValidEnrollmentDocument() {
      return request.resource.data.keys().hasOnly([
          "studentId",
          "courseId",
          "groupId",
          "mentorId",
          "price",
          "status",
          "enrolledAt",
          "completedAt",
          "updatedAt"
        ])
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() > 0
        && isEnrollmentStatus(request.resource.data.status)
        && request.resource.data.enrolledAt is timestamp
        && hasValidOptionalEnrollmentFields()
        && hasConsistentEnrollmentAssignment();
    }

    function isValidStudentEnrollmentCreate(enrollmentId) {
      return hasStudentProfile()
        && request.resource.data.keys().hasOnly([
          "studentId",
          "courseId",
          "status",
          "enrolledAt"
        ])
        && request.resource.data.studentId is string
        && request.resource.data.courseId is string
        && request.auth.uid == request.resource.data.studentId
        && enrollmentId == courseEnrollmentId(
          request.auth.uid,
          request.resource.data.courseId
        )
        && request.resource.data.status == "active"
        && request.resource.data.enrolledAt is timestamp
        && exists(/databases/$(database)/documents/Courses/$(request.resource.data.courseId))
        && get(/databases/$(database)/documents/Courses/$(request.resource.data.courseId)).data.active == true;
    }

    function isValidSuperAdminEnrollmentWrite(enrollmentId) {
      return isSuperAdmin()
        && enrollmentId == courseEnrollmentId(
          request.resource.data.studentId,
          request.resource.data.courseId
        )
        && isValidEnrollmentDocument();
    }

    function isValidCourseWrite() {
      return isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          "name",
          "description",
          "active",
          "mentorIds",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && (
          !("description" in request.resource.data)
          || request.resource.data.description is string
        )
        && (
          !("mentorIds" in request.resource.data)
          || request.resource.data.mentorIds is list
        )
        && (
          !("updatedAt" in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        );
    }

    function isValidStudentCreate(studentId) {
      return signedIn()
        && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly([
          "name",
          "lastName",
          "email",
          "phone",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && (
          !("phone" in request.resource.data)
          || request.resource.data.phone is string
        );
    }

    function isValidManagedStudentWrite() {
      return isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          "name",
          "lastName",
          "email",
          "phone",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.createdAt is timestamp
        && (
          !("phone" in request.resource.data)
          || request.resource.data.phone is string
        )
        && (
          !("updatedAt" in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        );
    }

    function isValidManagedMentorWrite() {
      return isSuperAdmin()
        && request.resource.data.keys().hasOnly([
          "name",
          "lastName",
          "email",
          "phone",
          "active",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && (
          !("phone" in request.resource.data)
          || request.resource.data.phone is string
        )
        && (
          !("updatedAt" in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        );
    }

    match /Students/{studentId} {
      allow get: if signedIn()
        && (
          request.auth.uid == studentId
          || hasMentorProfile()
          || isSuperAdmin()
        );
      allow list: if isSuperAdmin();
      allow create: if isValidStudentCreate(studentId)
        || isValidManagedStudentWrite();
      allow update: if isValidManagedStudentWrite();
      allow delete: if isSuperAdmin();
    }

    match /Mentors/{mentorId} {
      allow get: if signedIn()
        && (
          request.auth.uid == mentorId
          || isPortalUser()
        );
      allow list: if isSuperAdmin();
      allow create, update: if isValidManagedMentorWrite();
      allow delete: if isSuperAdmin();
    }

    match /SuperAdmins/{superAdminId} {
      allow get: if signedIn()
        && request.auth.uid == superAdminId;
      allow list, create, update, delete: if false;
    }

    match /Courses/{courseId} {
      allow get: if isSuperAdmin()
        || hasMentorProfile()
        || resource.data.active == true
        || isCurrentStudentEnrolledInCourse(courseId);
      allow list: if isSuperAdmin()
        || hasMentorProfile()
        || (hasStudentProfile() && resource.data.active == true);
      allow create, update: if isValidCourseWrite();
      allow delete: if isSuperAdmin();

      match /Groups/{groupId} {
        allow get, list: if isGroupMentor(courseId, groupId)
          || isCurrentStudentEnrolledInGroup(courseId, groupId);
        allow write: if false;

        match /Lessons/{lessonId} {
          allow get, list: if isGroupMentor(courseId, groupId)
            || isCurrentStudentEnrolledInGroup(courseId, groupId);
          allow create, update, delete: if isGroupMentor(courseId, groupId);
        }

        match /{document=**} {
          allow read, write: if false;
        }
      }

      match /PrivateStudents/{studentId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /Enrollments/{enrollmentId} {
      allow get, list: if signedIn()
        && (
          resource.data.studentId == request.auth.uid
          || resource.data.mentorId == request.auth.uid
          || isSuperAdmin()
        );
      allow create: if isValidStudentEnrollmentCreate(enrollmentId)
        || isValidSuperAdminEnrollmentWrite(enrollmentId);
      allow update: if isValidSuperAdminEnrollmentWrite(enrollmentId);
      allow delete: if isSuperAdmin();
    }

    match /Attendances/{attendanceId} {
      allow get, list: if isAttendanceReader();
      allow create, update: if isValidAttendanceWrite();
      allow delete: if isAttendanceReader()
        && isGroupMentor(resource.data.courseId, resource.data.groupId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
